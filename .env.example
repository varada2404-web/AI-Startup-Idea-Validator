# Copy to .env for local configuration. Keep real credentials out of Git.
# Empty keys are placeholders; LIVE mode will reject them until configured.
VALIDATOR_MODE=demo
GEMINI_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=
VALIDATOR_DB_PATH=
CORS_ALLOWED_ORIGINS=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048
TAVILY_TIMEOUT_SECONDS=20
TAVILY_MAX_RETRIES=1
TAVILY_MAX_RETRY_DELAY_SECONDS=10
MAX_PROVIDER_RESPONSE_BYTES=2000000
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_FOLLOW_UP_QUERIES=4
MAX_EXTRACT_SOURCES_PER_RUN=8
MAX_CONCURRENT_PROVIDER_CALLS=4
MAX_ACTIVE_LIVE_RUNS=1
MAX_SOURCE_TEXT_CHARS=12000
